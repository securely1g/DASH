load("@dash_generator_deps//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Makefile.dash",
    "make_with_flags.sh",
    "requirements_lock.txt",
])

py_test(
    name = "make_flags_test",
    srcs = ["make_flags_test.py"],
    args = [
        "$(rootpath :make_with_flags.sh)",
        "$(rootpath :Makefile.dash)",
        "$(rootpath @sonic_build_infra//tools/build_tools:configure_linker_flags.sh)",
        "$(rootpath @sonic_build_infra//tools/build_tools:configure_environment.sh)",
    ],
    data = [
        "Makefile.dash",
        "make_with_flags.sh",
        "@sonic_build_infra//tools/build_tools:configure_environment.sh",
        "@sonic_build_infra//tools/build_tools:configure_linker_flags.sh",
    ],
)

py_binary(
    name = "prepare",
    srcs = ["prepare.py"],
    # Match the locked generator wheels even when the consumer uses Python 3.11.
    python_version = "3.13",
    deps = [requirement(name) for name in [
        "jinja2",
        "pyyaml",
        "pyyaml-include",
        "jsonpath-ng",
    ]],
)

cc_binary(
    name = "sdk_consumer",
    testonly = True,
    srcs = ["sdk_consumer.cpp"],
    deps = ["//:sdk"],
)

cc_binary(
    name = "runtime_loader",
    testonly = True,
    srcs = ["runtime_loader.c"],
    linkopts = ["-ldl"],
)

py_test(
    name = "runtime_test",
    srcs = ["runtime_test.py"],
    args = [
        "$(rootpath //:runtime)",
        "$(rootpath //:runtime.debug_symbols)",
        "$(rootpath @p4lang_pi//:runtime)",
        "$(rootpath :sdk_consumer)",
        "$(rootpath :runtime_loader)",
        "$(rootpaths @p4lang_pi//:runtime_libraries)",
        "$(rootpaths @dash_deps//:packages)",
    ],
    data = [
        ":runtime_loader",
        ":sdk_consumer",
        "//:runtime",
        "//:runtime.debug_symbols",
        "@dash_deps//:packages",
        "@p4lang_pi//:runtime",
        "@p4lang_pi//:runtime_libraries",
    ],
)
